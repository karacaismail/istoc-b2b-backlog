{
  "name": "istoc-b2b-backlog-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "data": "python3 scripts/generate-data.py",
    "dev": "npm run data && vite",
    "build": "npm run data && npm run build:site",
    "build:site": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "check": "npm run build",
    "test:effort": "node --experimental-strip-types --test tests/effort-model.test.ts",
    "test:game-ui": "playwright test tests/game-ui.spec.ts",
    "test:planning": "node --experimental-strip-types --test tests/planning.test.ts",
    "test:tasks-ui": "playwright test tests/tasks-ui.spec.ts",
    "test:layout": "playwright test --config=playwright.layout.config.ts"
  },
  "dependencies": {
    "@pixi/ui": "^2.3.2",
    "@vueuse/core": "^14.0.0",
    "lucide-vue-next": "^0.544.0",
    "pixi.js": "^8.21.0",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "daisyui": "^5.1.13",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vue-tsc": "^3.0.7"
  }
}
